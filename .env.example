# HTTP
PORT=9890

# PostgreSQL (one database for the whole monolith)
DATABASE_URL=postgres://splitease:change-me@127.0.0.1:15433/splitease
DB_POOL_MAX_SIZE=10
# Apply pending SQL files from ./migrations on startup
AUTO_MIGRATE=true

# Optional: send GET /join to the website (shared invite links keep their #token), e.g.
# INVITE_LANDING_URL=https://splitease.lambrk.com/join
INVITE_LANDING_URL=

# Used only by compose.yml
POSTGRES_USER=splitease
POSTGRES_PASSWORD=change-me

# Allowed browser origins for CORS (comma separated, include scheme and port if applicable).
# The first origin is also used for email and invite links.
APP_URL=http://localhost:3000

# Outgoing email (SMTP). Leave SMTP_HOST empty to write emails to the log instead.
# Quote SMTP_PASSWORD if it contains # or spaces.
# For Hostinger Email, use smtp.hostinger.com with port 465 and SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=465
# true = TLS on connect (port 465); false = STARTTLS (port 587)
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=SplitEase
# Sender address; defaults to SMTP_USER
# MAIL_FROM_ADDRESS=no-reply@example.com
# Failed emails are retried (30s, 1m, 2m, 4m ... up to 1h apart) until MAIL_MAX_ATTEMPTS
MAIL_MAX_ATTEMPTS=8
MAIL_DISPATCH_DELAY=PT5S

# Auth (JWT_SECRET must be at least 32 characters)
JWT_SECRET=replace-with-at-least-32-characters
JWT_LIFETIME=PT1H
REFRESH_TOKEN_LIFETIME=P30D
EMAIL_VERIFICATION_LIFETIME=PT24H
LOGIN_MAXIMUM_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW=PT15M
LOGIN_BLOCK_DURATION=PT15M

# Groups
GROUP_INVITATION_LIFETIME=P7D

# Domain events (in-process outbox dispatcher; replaces Kafka)
OUTBOX_PUBLISH_DELAY=PT2S

# Push notifications (Firebase Cloud Messaging)
PUSH_DELIVERY_ENABLED=false
PUSH_DISPATCH_DELAY=PT5S

# Firebase Google sign-in + push. Credentials are read from GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-service-account.json

# Google Play subscriptions
GOOGLE_PLAY_VERIFICATION_ENABLED=false
GOOGLE_PLAY_PACKAGE_NAME=com.splitease.app
GOOGLE_PLAY_PUSH_AUDIENCE=https://api.example.com/api/v1/subscriptions/webhooks/google
GOOGLE_PLAY_PUSH_SERVICE_ACCOUNT_EMAIL=play-push@example-project.iam.gserviceaccount.com
GOOGLE_PLAY_PUSH_SUBSCRIPTION=projects/example-project/subscriptions/play-rtdn

# Apple App Store subscriptions
APPLE_STORE_VERIFICATION_ENABLED=false
APPLE_BUNDLE_ID=com.splitease.app
APPLE_APP_ID=0
APPLE_STORE_ENVIRONMENT=PRODUCTION
APPLE_ROOT_CERTIFICATE_PATHS=/absolute/path/to/AppleRootCA-G3.cer

# API audit log
API_LOG_ENABLED=true
API_LOG_BODY_LIMIT=16384
